[Unit]
Description=VLESS WebSocket Server (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 部署前请修改为实际路径
WorkingDirectory=/home/vless-ws-go
ExecStart=/home/vless-ws-go/vless-ws-server

# 从这个文件加载 UUID/TOKEN 等环境变量，由 deploy.sh 从
# server.env（cp server.env.example 而来）自动同步过来。
# 该文件缺失或里面没有设置 UUID 时，服务会拒绝启动（config.go 里的校验），
# 不会再有任何默认凭据可用，这是有意为之的安全设计。
EnvironmentFile=/home/vless-ws-go/server.env

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
