# 服务端运行配置。
# 首次使用：
#   cp server.env.example server.env
#   然后编辑 server.env，务必换成你自己的 UUID（和可选的 TOKEN）
#
# ⚠️ 安全提示：UUID 不再有默认值，必须在这里显式设置，否则服务端会拒绝启动。
#    绝对不要用下面示例里的 UUID/TOKEN 原样上线——这两个值只是格式示例，
#    没有任何随机性/机密性，照抄等于把凭据公开在你能看到这份文件的地方。
#    生成一个新的随机 UUID，例如执行：uuidgen（Linux/macOS 自带）
#
# server.env 不会被 deploy.sh / run-server.sh 覆盖，改这个文件就行。

UUID="替换成你自己生成的随机UUID，例如用 uuidgen 生成"
TOKEN="可选，留空表示关闭 Token 校验；建议设置一个随机字符串加一层鉴权"

HOST="0.0.0.0"
PORT="8081"
WS_PATH="/api"

# 下面这些是可选项，跟 config.go 里的默认值一致，一般不需要改：
# IDLE_TIMEOUT_MS="120000"
# HEARTBEAT_MS="25000"
# CONNECT_TIMEOUT_MS="12000"
# CONNECT_RETRIES="1"
# RETRY_BASE_MS="200"
# MAX_FRAME_BYTES="2097152"
# LOG_LEVEL="info"
# YAMUX_WINDOW_KB="20480"
# YAMUX_WRITE_TIMEOUT_MS="15000"
# NAT64_PREFIX="64:ff9b::"
